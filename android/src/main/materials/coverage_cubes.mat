material {
    name : "Capture3D Coverage Cubes",
    requires : [ color ],
    shadingModel : unlit,
    blending : opaque,
    depthWrite : true,
    depthCulling : true
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = getColor();
    }
}
